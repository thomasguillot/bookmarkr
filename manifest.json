{
	"manifest_version": 3,
	"name": "__MSG_extensionName__",
	"version": "3.0.1",
	"description": "__MSG_extensionDescription__",
	"default_locale": "en",
	"permissions": ["bookmarks", "downloads"],
	"background": {
		"service_worker": "build/service-worker.js"
	},
	"action": {
