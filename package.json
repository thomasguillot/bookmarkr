{
	"name": "bookmarkr",
	"version": "3.0.0",
	"license": "GPL-3.0-only",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc --noEmit && vite build",
		"build:icons": "tsx scripts/build-icons.ts",
		"lint": "eslint . && npm run lint:html",
		"lint:fix": "eslint . --fix",
		"lint:html": "html-validate src/**/*.html",
		"prebuild": "npm run build:icons",
		"release": "tsx scripts/release-zip.ts",
		"prepare": "husky",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"radix-ui": "^1.4.3",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.0"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": "eslint",
		"*.html": "html-validate"
	},
	"devDependencies": {
		"@eslint/js": "^9.15.0",
		"@types/chrome": "^0.1.42",
		"@types/node": "^25.9.1",
		"@types/react": "^18.3.29",
		"@types/react-dom": "^18.3.7",
		"@vitejs/plugin-react": "^4.3.3",
		"archiver": "^7.0.1",
		"eslint": "^9.15.0",
		"eslint-plugin-react": "^7.37.2",
		"eslint-plugin-react-hooks": "^5.0.0",
		"eslint-plugin-react-refresh": "^0.4.14",
		"globals": "^15.12.0",
		"html-validate": "^8.25.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"sharp": "^0.33.5",
		"tsx": "^4.22.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.0",
		"vite": "^6.0.1"
	}
}
